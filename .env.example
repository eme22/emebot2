# =================================================================
# EMBot Configuration Environment Variables
# =================================================================

# --- Application Tokens & Keys ---
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_TOKEN=your_client_token_here
JWT_SECRET=super-secret-key-that-should-be-changed-12345678
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# --- AI Chat Tuning (opcional) ---
# Compactación de contexto por resumen continuo
OPENAI_COMPACT_THRESHOLD=40
OPENAI_COMPACT_KEEP_RECENT=12
# Anti-spam: cooldown por usuario y solicitudes concurrentes máximas por canal
OPENAI_USER_COOLDOWN=3
OPENAI_MAX_CONCURRENT_PER_CHANNEL=1

# --- Exa Web Search (opcional) ---
# Sin API key usa el MCP gratuito de Exa (~50-150 búsquedas/día compartidas por IP).
# Con API key se eliminan los límites: https://dashboard.exa.ai/api-keys
EXA_MCP_URL=https://mcp.exa.ai/mcp?tools=web_search_exa
EXA_API_KEY=

# --- Web Panel Admin Credentials ---
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=password

# --- Database Configuration (MariaDB) ---
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=s15_mbot
DB_USER=embot_user
DB_PASSWORD=embot_password
DB_ROOT_PASSWORD=root_password

# --- Lavalink Configuration ---
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# --- Server HTTP Configuration ---
SERVER_PORT=8080
SERVER_IP=0.0.0.0
